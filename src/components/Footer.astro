---
import Mark from './Mark.astro';
import { SITE } from '../data/site';
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="foot-brand" href="/"><Mark /> FRANCOZ <small>SECURITY</small></a>
        <p class="foot-line">{SITE.lema}</p>
        <p style="margin-top:18px"><span class="chip live">Etapa {SITE.etapa.numero} · {SITE.etapa.nombre}</span></p>
      </div>
      <div>
        <h2 class="foot-h">Explorar</h2>
        <ul><li><a href="/areas/">Áreas</a></li><li><a href="/proyectos/">Proyectos</a></li><li><a href="/lab/">Lab</a></li><li><a href="/notas/">Notas</a></li></ul>
      </div>
      <div>
        <h2 class="foot-h">Proyecto</h2>
        <ul><li><a href="/sobre/">Sobre</a></li><li><a href="/sobre/#hoja-de-ruta">Hoja de ruta</a></li><li><a href="/uso-responsable/">Uso responsable</a></li></ul>
      </div>
      <div>
        <h2 class="foot-h">Contacto</h2>
        <ul><li><a href="/contacto/">Escribir a FRANCOZ</a></li><li><a href="/rss.xml">RSS</a></li></ul>
      </div>
    </div>
    <div class="legal">
      <span>© {SITE.anio} {SITE.nombre}</span><span>Proyecto en desarrollo</span><span>Contenido con fines educativos</span>
    </div>
  </div>
</footer>

<style>
  .foot-h{font-family:var(--f-mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;margin:0 0 14px}
</style>
