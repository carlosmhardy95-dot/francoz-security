---
import Mark from './Mark.astro';
import { SITE } from '../data/site';
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="foot-brand" href="/"><Mark /> FRANCOZ <small>SECURITY</small></a>
        <p class="foot-line">{SITE.lema}</p>
        <p style="margin-top:18px"><span class="chip">Ciberseguridad para empresas y PyMEs</span></p>
      </div>
      <div>
        <h2 class="foot-h">Servicios</h2>
        <ul>
          <li><a href="/servicios/evaluacion-de-ciberseguridad/">Evaluación de ciberseguridad</a></li>
          <li><a href="/servicios/pruebas-de-penetracion/">Pentesting</a></li>
          <li><a href="/servicios/gestion-de-riesgos/">Gestión de riesgos</a></li>
          <li><a href="/servicios/">Todos los servicios</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-h">Empresa</h2>
        <ul><li><a href="/nosotros/">Nosotros</a></li><li><a href="/#metodo">Método</a></li><li><a href="/marco-de-trabajo/">Marco de trabajo</a></li><li><a href="/lab/">FRANCOZ LAB</a></li><li><a href="/insights/">Insights</a></li></ul>
      </div>
      <div>
        <h2 class="foot-h">Contacto</h2>
        <ul><li><a href="/contacto/">Solicitar evaluación</a></li><li><a href="/rss.xml">RSS</a></li></ul>
      </div>
    </div>
    <div class="legal">
      <span>© {SITE.anio} {SITE.nombre}</span><span>Ciberseguridad · Gestión de riesgos · Inteligencia</span>
    </div>
  </div>
</footer>

<style>
  .foot-h{font-family:var(--f-mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;margin:0 0 14px}
</style>
