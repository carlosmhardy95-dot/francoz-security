---
import Mark from './Mark.astro';
import { NAV, CTA } from '../data/site';
const actual = Astro.url.pathname;
const esActual = (href: string) => !href.includes('#') && (actual === href || actual.startsWith(href));
---
<header class="topbar">
  <a class="tb-brand" href="/" aria-label="FRANCOZ SECURITY, ir al inicio">
    <Mark />
    <b>FRANCOZ</b><small>SECURITY</small>
  </a>
  <button class="tb-burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="tb-menu"><i></i><i></i></button>
  <div class="tb-menu" id="tb-menu">
    <nav class="tb-nav" aria-label="Principal">
      {NAV.map((item) => (
        <a href={item.href} aria-current={esActual(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="tb-cta" href={CTA.href}>
      {CTA.texto}
      <i><svg viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m6.6 3.6 6 5.4-6 5.4" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></i>
    </a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.tb-burger');
  const menu = document.getElementById('tb-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      open ? menu.setAttribute('data-open', '') : menu.removeAttribute('data-open');
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(btn.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
  }
</script>
