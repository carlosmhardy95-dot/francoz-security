---
import type { CollectionEntry } from 'astro:content';
import { numeroLab, fechaLarga } from '../data/site';
import { areaPorSlug } from '../data/areas';
interface Props {
  entradas: CollectionEntry<'lab'>[];
  formato?: boolean;
}
const { entradas, formato = true } = Astro.props;
---
<div class="log glass">
  {entradas.length === 0 && (
    <p class="log-intro">Investigación aplicada en entornos controlados: técnicas, configuraciones y amenazas, documentadas con un formato fijo y verificable.</p>
  )}
  {entradas.map((e) => (
    <a class="log-row" href={`/lab/${e.id}/`}>
      <span class="no">{numeroLab(e.data.numero)}</span>
      <span class="tt">{e.data.titulo}</span>
      <span class="meta">
        <span>{areaPorSlug(e.data.area).nombre}</span>
        <span>{e.data.tipo}</span>
        {e.data.tecnologias.length > 0 && <span>{e.data.tecnologias.join(' · ')}</span>}
        <span>{fechaLarga(e.data.fecha)}</span>
      </span>
    </a>
  ))}
  {formato && (
    <div class="fmt">
      <h4>Formato de cada publicación</h4>
      <ol><li>Objetivo</li><li>Entorno</li><li>Proceso</li><li>Resultado</li><li>Limitaciones</li><li>Conclusiones</li></ol>
    </div>
  )}
</div>

<style>
  .log-intro{padding:18px 0 6px;font-size:15.5px;line-height:1.55;color:var(--muted2)}
</style>
