---
import { SITE } from '../data/site';
// La hoja de ruta. Para avanzar de etapa, cambiá SITE.etapa en src/data/site.ts.
const etapas = [
  { n: '01', nombre: 'Fundamentos', texto: 'Formación académica, laboratorios numerados y documentación de cada práctica.' },
  { n: '02', nombre: 'Investigación aplicada', texto: 'Proyectos de mayor alcance, herramientas propias y publicaciones.' },
  { n: '03', nombre: 'Primeros servicios', texto: 'Diagnósticos acotados y capacitación, cuando la formación y la práctica lo respalden.' },
  { n: '04', nombre: 'Consultora', texto: 'Equipo, metodología propia y servicios integrales.' },
];
---
<ol class="road" aria-label="Hoja de ruta">
  {etapas.map((e) => {
    const actual = e.n === SITE.etapa.numero;
    return (
      <li class={actual ? 'now' : undefined}>
        <span class="n">{e.n}</span>
        <div class="body">
          <h3>{e.nombre} {actual && <span class="chip live">En curso</span>}</h3>
          <p>{e.texto}</p>
        </div>
      </li>
    );
  })}
</ol>
