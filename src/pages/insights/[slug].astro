---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { numeroLab, fechaLarga, minutosDeLectura, CTA } from '../../data/site';
import { areaPorSlug } from '../../data/areas';

export async function getStaticPaths() {
  const notas = (await getCollection('notas', (n) => n.data.estado === 'publicada')).sort(
    (a, b) => (a.data.fecha?.getTime() ?? 0) - (b.data.fecha?.getTime() ?? 0)
  );
  const lab = await getCollection('lab', (e) => e.data.estado === 'publicada');
  const servicios = await getCollection('servicios');
  return notas.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      anterior: notas[i - 1] ?? null,
      siguiente: notas[i + 1] ?? null,
      labRelacionado: lab.filter((e) => entry.data.lab.includes(e.id)),
      serviciosRelacionados: servicios.filter((s) => entry.data.servicios.includes(s.id)),
    },
  }));
}

const { entry, anterior, siguiente, labRelacionado, serviciosRelacionados } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const area = areaPorSlug(d.area);
const enlace = (e: typeof entry | null) => (e ? { href: `/insights/${e.id}/`, titulo: e.data.titulo } : null);
---
<Entry
  titulo={d.titulo}
  descripcion={d.descripcion}
  kicker={`Insights · ${area.nombre}`}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Insights', href: '/insights/' }, { label: d.titulo }]}
  chips={[
    ...(d.fecha ? [{ texto: fechaLarga(d.fecha) }] : []),
    { texto: `${minutosDeLectura(entry.body)} min de lectura` },
    ...(d.revision ? [{ texto: `Revisado el ${fechaLarga(d.revision)}` }] : []),
  ]}
  anterior={enlace(anterior)}
  siguiente={enlace(siguiente)}
  fecha={d.fecha}
  revision={d.revision}
>
  <Content />
  <Fragment slot="side">
    {serviciosRelacionados.length > 0 && (
      <div class="side-box glass">
        <h2>Servicios relacionados</h2>
        <ul>{serviciosRelacionados.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.nombre}</a></li>)}</ul>
        <a class="textlink" href={CTA.href} style="font-size:14.5px;margin-top:16px">{CTA.texto}</a>
      </div>
    )}
    {labRelacionado.length > 0 && (
      <div class="side-box glass">
        <h2>En FRANCOZ LAB</h2>
        <ul>{labRelacionado.map((e) => <li><a href={`/lab/${e.id}/`}>{numeroLab(e.data.numero)} · {e.data.titulo}</a></li>)}</ul>
      </div>
    )}
  </Fragment>
</Entry>
