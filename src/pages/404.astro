---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Página no encontrada">
  <main id="contenido">
    <PageHead
      kicker="Error 404"
      titulo="Esta página no existe."
      lead="Puede que la dirección esté mal escrita o que la página se haya movido."
    >
      <a class="textlink" href="/">Volver al inicio</a> <a class="textlink" href="/servicios/" style="margin-left:24px">Ver servicios</a>
    </PageHead>
  </main>
</Base>
