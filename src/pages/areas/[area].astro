---
// Dirección vieja: redirige a la nueva. (Se mantiene para que los enlaces antiguos sigan funcionando.)
export function getStaticPaths() {
  return [
    { params: { area: 'defensa' }, props: { to: '/servicios/#proteccion' } },
    { params: { area: 'riesgo' }, props: { to: '/servicios/#riesgo-inteligencia' } },
    { params: { area: 'inteligencia' }, props: { to: '/servicios/#riesgo-inteligencia' } },
    { params: { area: 'automatizacion' }, props: { to: '/servicios/' } },
  ];
}
return Astro.redirect(Astro.props.to);
---
