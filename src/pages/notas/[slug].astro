---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { numeroLab, fechaLarga, minutosDeLectura } from '../../data/site';
import { areaPorSlug } from '../../data/areas';

export async function getStaticPaths() {
  const notas = (await getCollection('notas', (n) => n.data.estado === 'publicada')).sort(
    (a, b) => (a.data.fecha?.getTime() ?? 0) - (b.data.fecha?.getTime() ?? 0)
  );
  const lab = await getCollection('lab', (e) => e.data.estado === 'publicada');
  return notas.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      anterior: notas[i - 1] ?? null,
      siguiente: notas[i + 1] ?? null,
      mismaArea: notas.filter((n) => n.id !== entry.id && n.data.area === entry.data.area).slice(0, 3),
      labRelacionado: lab.filter((e) => entry.data.lab.includes(e.id)),
    },
  }));
}

const { entry, anterior, siguiente, mismaArea, labRelacionado } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const area = areaPorSlug(d.area);
const enlace = (e: typeof entry | null) => (e ? { href: `/notas/${e.id}/`, titulo: e.data.titulo } : null);
---
<Entry
  titulo={d.titulo}
  descripcion={d.descripcion}
  kicker={`${area.nombre} · ${d.tipo}`}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Notas', href: '/notas/' }, { label: d.titulo }]}
  chips={[
    ...(d.fecha ? [{ texto: fechaLarga(d.fecha) }] : []),
    { texto: `${minutosDeLectura(entry.body)} min de lectura` },
    ...(d.revision ? [{ texto: `Revisada el ${fechaLarga(d.revision)}` }] : []),
  ]}
  anterior={enlace(anterior)}
  siguiente={enlace(siguiente)}
  fecha={d.fecha}
  revision={d.revision}
>
  <Content />
  <Fragment slot="side">
    {labRelacionado.length > 0 && (
      <div class="side-box glass">
        <h2>En FRANCOZ LAB</h2>
        <ul>{labRelacionado.map((e) => <li><a href={`/lab/${e.id}/`}>{numeroLab(e.data.numero)} · {e.data.titulo}</a></li>)}</ul>
      </div>
    )}
    <div class="side-box glass">
      <h2>Área {area.nombre}</h2>
      {mismaArea.length > 0 ? (
        <ul>{mismaArea.map((n) => <li><a href={`/notas/${n.id}/`}>{n.data.titulo}</a></li>)}</ul>
      ) : (
        <p style="font-size:15px;color:var(--muted2)">{area.enfoque}</p>
      )}
      <a class="textlink" href={`/areas/${area.slug}/`} style="font-size:14.5px;margin-top:16px">Ver el área</a>
    </div>
  </Fragment>
</Entry>
