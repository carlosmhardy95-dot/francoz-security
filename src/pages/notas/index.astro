---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NoteCard from '../../components/NoteCard.astro';
import { todasLasNotas } from '../../data/contenido';
import { AREAS } from '../../data/areas';

const notas = await todasLasNotas();
const porArea = AREAS.map((a) => ({ area: a, notas: notas.filter((n) => n.data.area === a.slug) })).filter((g) => g.notas.length);
---
<Base title="Notas" description="Notas de FRANCOZ SECURITY: conceptos, guías y comparaciones de ciberseguridad explicadas para entender, no para asustar.">
  <main id="contenido">
    <PageHead
      kicker="Notas"
      titulo="Seguridad explicada, sin humo."
      lead="Conceptos, guías y comparaciones escritas para entender, no para asustar."
      migas={[{ label: 'Inicio', href: '/' }, { label: 'Notas' }]}
    />
    <section class="sec">
      <div class="wrap">
        {porArea.length === 0 && <p class="empty">Las primeras notas están en preparación.</p>}
        {porArea.map((g, i) => (
          <div class={i > 0 ? 'block' : undefined}>
            <div class="colhead">
              <h2 style="font-size:22px;font-weight:470;margin:0">{g.area.nombre}</h2>
              <a class="textlink" href={`/areas/${g.area.slug}/`} style="margin:0;font-size:14.5px">Ver el área</a>
            </div>
            <div class="notes" style="margin-top:28px">{g.notas.map((n) => <NoteCard n={n} />)}</div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>
