---
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** La Home usa su propio encabezado dentro del hero */
  home?: boolean;
  type?: 'website' | 'article';
}
const { title, description = SITE.descripcion, jsonld, home = false, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.nombre}` : `${SITE.nombre} — ${SITE.lema}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18.4" fill="#E6EDF6" stroke="#0d1b30" stroke-width="2"/><path d="M3.4 27.4 36.6 12.6" stroke="#0d1b30" stroke-width="2.4" stroke-linecap="round"/><circle cx="14.4" cy="14.2" r="3.2" fill="#0d1b30"/></svg>'
)}`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#E6EDF6" />
    <link rel="icon" href={favicon} />
    <link rel="alternate" type="application/rss+xml" title={SITE.nombre} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        // si el script de movimiento no llega a cargar, mostrar todo igual
        setTimeout(function () { if (!window.__fzMotion) d.classList.remove('motion'); }, 2500);
      })();
    </script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    {!home && <div class="wrap"><Header /></div>}
    <slot />
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
